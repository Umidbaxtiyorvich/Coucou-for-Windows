LangString addOrReinstall ${LANG_UZBEK} "Komponentlarni qo‘shish yoki qayta o‘rnatish"
LangString alreadyInstalled ${LANG_UZBEK} "Allaqachon o‘rnatilgan"
LangString alreadyInstalledLong ${LANG_UZBEK} "${PRODUCTNAME} ${VERSION} allaqachon o‘rnatilgan. Bajarmoqchi bo‘lgan amalni tanlang va davom etish uchun «Keyingi» tugmasini bosing."
LangString appRunning ${LANG_UZBEK} "{{product_name}} ishlab turibdi! Avval uni yoping, so‘ng qayta urinib ko‘ring."
LangString appRunningOkKill ${LANG_UZBEK} "{{product_name}} ishlab turibdi!$\nUni yopish uchun OK tugmasini bosing"
LangString chooseMaintenanceOption ${LANG_UZBEK} "Bajariladigan xizmat amalini tanlang."
LangString choowHowToInstall ${LANG_UZBEK} "${PRODUCTNAME} ni qanday o‘rnatishni tanlang."
LangString createDesktop ${LANG_UZBEK} "Ish stolida yorliq yaratish"
LangString dontUninstall ${LANG_UZBEK} "O‘chirib tashlamaslik"
LangString dontUninstallDowngrade ${LANG_UZBEK} "O‘chirib tashlamaslik (bu o‘rnatuvchida o‘chirmasdan eski versiyaga qaytish o‘chirilgan)"
LangString failedToKillApp ${LANG_UZBEK} "{{product_name}} ni yopib bo‘lmadi. Avval uni yoping, so‘ng qayta urinib ko‘ring"
LangString installingWebview2 ${LANG_UZBEK} "WebView2 o‘rnatilmoqda..."
LangString newerVersionInstalled ${LANG_UZBEK} "${PRODUCTNAME} ning yangiroq versiyasi allaqachon o‘rnatilgan! Eskiroq versiyani o‘rnatish tavsiya etilmaydi. Agar rostdan ham shu eski versiyani o‘rnatmoqchi bo‘lsangiz, avval joriy versiyani o‘chirib tashlagan ma’qul. Bajarmoqchi bo‘lgan amalni tanlang va davom etish uchun «Keyingi» tugmasini bosing."
LangString older ${LANG_UZBEK} "eskiroq"
LangString olderOrUnknownVersionInstalled ${LANG_UZBEK} "Tizimingizda ${PRODUCTNAME} ning $R4 versiyasi o‘rnatilgan. O‘rnatishdan oldin joriy versiyani o‘chirib tashlash tavsiya etiladi. Bajarmoqchi bo‘lgan amalni tanlang va davom etish uchun «Keyingi» tugmasini bosing."
LangString silentDowngrades ${LANG_UZBEK} "Bu o‘rnatuvchida eski versiyaga qaytish o‘chirilgan, jim rejimdagi o‘rnatuvchi davom eta olmaydi, iltimos, buning o‘rniga grafik interfeysli o‘rnatuvchidan foydalaning.$\n"
LangString unableToUninstall ${LANG_UZBEK} "O‘chirib tashlab bo‘lmadi!"
LangString uninstallApp ${LANG_UZBEK} "${PRODUCTNAME} ni o‘chirib tashlash"
LangString uninstallBeforeInstalling ${LANG_UZBEK} "O‘rnatishdan oldin o‘chirib tashlash"
LangString unknown ${LANG_UZBEK} "noma’lum"
LangString webview2AbortError ${LANG_UZBEK} "WebView2 ni o‘rnatib bo‘lmadi! Ilova usiz ishlay olmaydi. O‘rnatuvchini qayta ishga tushirib ko‘ring."
LangString webview2DownloadError ${LANG_UZBEK} "Xato: WebView2 ni yuklab olib bo‘lmadi - $0"
LangString webview2DownloadSuccess ${LANG_UZBEK} "WebView2 o‘rnatuvchisi muvaffaqiyatli yuklab olindi"
LangString webview2Downloading ${LANG_UZBEK} "WebView2 o‘rnatuvchisi yuklab olinmoqda..."
LangString webview2InstallError ${LANG_UZBEK} "Xato: WebView2 ni o‘rnatish $1 chiqish kodi bilan muvaffaqiyatsiz tugadi"
LangString webview2InstallSuccess ${LANG_UZBEK} "WebView2 muvaffaqiyatli o‘rnatildi"
LangString deleteAppData ${LANG_UZBEK} "Ilova ma’lumotlarini o‘chirish"
